{
  "name": "lgu-tracker",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "clean": "rm -rf .next dist",
    "lint": "tsc --noEmit",
    "dpwh:iligan-export": "tsx --conditions=react-server scripts/dpwh-iligan-export.ts",
    "dpwh:sync": "tsx --conditions=react-server --max-old-space-size=4096 scripts/dpwh-sync.ts",
    "test": "tsx --conditions=react-server --test \"tests/dpwh/*.test.ts\" \"tests/bettergov/*.test.ts\" \"tests/bp/*.test.ts\"",
    "test:db": "tsx --conditions=react-server --test \"tests/db/*.test.ts\"",
    "test:db:full": "tsx --conditions=react-server --max-old-space-size=6144 tests/db/full-import.ts",
    "bettergov:sync": "tsx --conditions=react-server scripts/bettergov-sync.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "^9.3.1",
    "@types/leaflet": "^1.9.22",
    "dotenv": "^17.2.3",
    "hyparquet": "1.31.5",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.4.3",
    "postcss": "^8.5.31",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.7",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "4.20.6",
    "typescript": "^7.0.2"
  }
}
